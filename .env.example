# Required: your TeraBox 'ndus' cookie (browser DevTools > Application > Cookies)
NDUS_COOKIE=

# Required in production: random string used to sign proxy links
# generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: if set, clients must send header  X-API-Key: <value>  to /api/extract
API_KEY=

# Public URL of this API (used to build proxy_url), e.g. https://your-api.com
PUBLIC_BASE_URL=

PORT=8000
EXTRACT_RATE_LIMIT=30/minute
PROXY_RATE_LIMIT=120/minute
LINK_TTL=3600
CACHE_TTL=300
MAX_FOLDER_FILES=200
MAX_FOLDER_DEPTH=3
